{
  "name": "@xnlc/core",
  "version": "1.0.7",
  "description": "XNLC Core - Minecraft launcher library: version resolution, loader installation (Fabric, Quilt, NeoForge, Forge, LiteLoader, OptiFine), asset management, and game launching",
  "type": "module",
  "author": "MAINER4IK",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xnlc/xnlc-core.git"
  },
  "homepage": "https://github.com/xnlc/xnlc-core#readme",
  "bugs": {
    "url": "https://github.com/xnlc/xnlc-core/issues"
  },
  "keywords": [
    "minecraft",
    "launcher",
    "fabric",
    "quilt",
    "neoforge",
    "forge",
    "liteloader",
    "optifine",
    "minecraft-launcher",
    "xnlc",
    "xneon"
  ],
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./microsoft": {
      "types": "./lib/microsoft.d.ts",
      "default": "./lib/microsoft.js"
    },
    "./retry": {
      "types": "./lib/retry.d.ts",
      "default": "./lib/retry.js"
    },
    "./game-features": {
      "types": "./lib/game-features.d.ts",
      "default": "./lib/game-features.js"
    },
    "./game-readiness": {
      "types": "./lib/game-readiness.d.ts",
      "default": "./lib/game-readiness.js"
    }
  },
  "dependencies": {
    "@xnlc/types": "workspace:*",
    "adm-zip": "^0.6.0",
    "iconv-lite": "^0.7.3"
  },
  "scripts": {
    "generate:legacy": "bun scripts/generate-legacy-bootstrap.mjs",
    "build": "bun ./scripts/clean-legacy-forge-launch.mjs && bun --bun run tsc -p tsconfig.json",
    "clean": "rm -rf lib",
    "prepublishOnly": "bun run build"
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "publishConfig": {
    "registry": "https://git.xneon.org/api/packages/MAINER4IK/npm/"
  }
}
