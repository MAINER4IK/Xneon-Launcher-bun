{
  "name": "@xnlc/types",
  "version": "1.0.9",
  "description": "XNLC Shared Type Definitions — single source of truth for IPC contracts, domain types, worker messages, and launch configs",
  "type": "module",
  "author": "MAINER4IK",
  "license": "MIT",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    }
  },
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "files": [
    "lib"
  ],
  "dependencies": { "@xnlc/share": "workspace:*" },
  "scripts": {
    "build": "bun -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\" && bun --bun run tsc -p tsconfig.json",
    "clean": "bun -e \"require('node:fs').rmSync('lib',{recursive:true,force:true})\""
  },
  "publishConfig": {
    "registry": "https://git.xneon.org/api/packages/MAINER4IK/npm/"
  }
}
