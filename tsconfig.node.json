{
  "compilerOptions": {
    "lib": [
      "ESNext",
      "DOM"
    ],
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": false,
    "strictNullChecks": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "types": [
      "node",
      "bun"
    ],
    "noEmit": true,
    "paths": {
      "electrobun/view": [
        "./.hutch/devkit/api/browser/index.ts"
      ],
      "electrobun/main": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ],
      "electrobun": [
        "./.hutch/devkit/api/sdks/main/index.ts"
      ]
    }
  },
  "include": [
    "electrobun/**/*.ts",
    "electrobun/**/*.d.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
